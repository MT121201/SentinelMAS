{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "SentinelMAS — Daily LLM cost, RPM/TPM utilisation, token burn rate",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 30},
            {"color": "red", "value": 45}
          ]},
          "unit": "currencyUSD", "decimals": 4
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Daily LLM Spend",
      "type": "stat",
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "mas_daily_cost_usd", "legendFormat": "daily cost"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 75},
            {"color": "red", "value": 90}
          ]},
          "unit": "percent"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "RPM Utilisation",
      "type": "stat",
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "mas_rate_limit_rpm_utilisation_pct", "legendFormat": "RPM util%"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 75},
            {"color": "red", "value": 90}
          ]},
          "unit": "percent"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "TPM Utilisation",
      "type": "stat",
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "mas_rate_limit_tpm_utilisation_pct", "legendFormat": "TPM util%"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 80},
            {"color": "red", "value": 95}
          ]},
          "unit": "percent"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "title": "Daily Budget Used",
      "type": "stat",
      "targets": [{"datasource": {"uid": "prometheus"}, "expr": "mas_daily_cost_budget_utilisation_pct", "legendFormat": "budget%"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "unit": "currencyUSD"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Daily Cost Accumulation",
      "type": "timeseries",
      "targets": [
        {"datasource": {"uid": "prometheus"}, "expr": "mas_daily_cost_usd", "legendFormat": "cumulative spend"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Token Usage Rate (per minute)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"uid": "prometheus"}, "expr": "mas_tokens_per_minute_total", "legendFormat": "TPM (prompt + completion)"},
        {"datasource": {"uid": "prometheus"}, "expr": "mas_tokens_per_minute_prompt", "legendFormat": "TPM prompt"},
        {"datasource": {"uid": "prometheus"}, "expr": "mas_tokens_per_minute_completion", "legendFormat": "TPM completion"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["sentinelmas", "cost", "llmops"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "SentinelMAS — Token Spend & Rate Limits",
  "uid": "sentinelmas-cost",
  "version": 1
}
